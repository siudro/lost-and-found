# Copy to .env for local development. Nothing here is required to run the
# demo: the app starts with every value unset and says so in its log.

# Where the SQLite database lives. On Railway, point this at the mounted
# volume or reports and events vanish on redeploy.
DATABASE_PATH=./data/foundit.db

# Venue timezone used to resolve "yesterday" and "4 PM".
VENUE_TIMEZONE=Asia/Riyadh

# --- AI providers (all optional) ---------------------------------------
# Each one improves quality; none is needed for the app to answer questions.
# See /api/providers for the live status of each.

# Open-vocabulary detector, so items can be found by name rather than by blob.
# Without it: rule-based motion detector only.
DETECTOR_MODEL=

# Segment Anything checkpoint (gated download, needs a Hugging Face token and
# accepting the licence on the model page). Without it: detector boxes.
SAM_CHECKPOINT=
HF_TOKEN=

# Vision-language captioner API key. Without it: colour + class label.
CAPTION_API_KEY=

# OpenAI key for the chat. Used ONLY to rephrase an already-composed answer and
# to reply to chat that is not a search; times and numbers it adds are rejected.
# Set it in Railway > Variables, never in a file that is committed.
LLM_API_KEY=
# Default gpt-4o-mini.
LLM_MODEL=
# Cost guards: most calls per day (UTC) and longest reply, in tokens.
LLM_DAILY_CALL_LIMIT=150
LLM_MAX_OUTPUT_TOKENS=160

# Embedding model for semantic retrieval. Without it: keyword only.
EMBED_MODEL=

# Set to 1 to log every retrieval decision.
DEBUG_RETRIEVAL=0
